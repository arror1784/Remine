# Copy this file to /opt/remine.env on the server (NOT into the git checkout —
# see docker-compose.prod.yml's app-api.env_file comment for why) and fill in
# real values. Never commit the filled-in file.

# --- Required (app boots but fails fast without these — see
# Remine_backend/docs/production-deployment.md) ---
JWT_SECRET=
DB_URL=jdbc:postgresql://postgres:5432/remine
DB_USER=
DB_PASSWORD=
REDIS_HOST=redis

# --- Optional, with defaults ---
REDIS_PORT=6379
OPENAI_MODEL=gpt-4o-mini

# --- Optional but recommended in production ---
OPENAI_API_KEY=
# Use a freshly issued key — never reuse the key from
# Remine_backend/app-api/src/main/resources/application-local.yml, which is
# gitignored precisely because it may hold a real key from local development.

# Same-origin deployment (nginx proxies /api on the same domain the page is
# served from) means CORS is never actually triggered by the browser, but
# fill it in anyway so the intent is explicit rather than relying on
# CorsConfig's empty-string filtering.
CORS_ALLOWED_ORIGINS=https://<duckdns-subdomain>.duckdns.org

# --- Upload storage (missing from the original runbook — see
# Remine_backend/app-api/src/main/resources/application.yml's storage.* keys) ---
# STORAGE_PUBLIC_BASE_URL in particular is written into the database as part
# of every uploaded photo's URL — get it wrong once and old rows stay broken
# even after you fix it.
STORAGE_UPLOAD_DIR=/app/uploads
STORAGE_PUBLIC_BASE_URL=https://<duckdns-subdomain>.duckdns.org

# --- Google OAuth (config-only — no callback handler implemented yet, safe
# to leave empty) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Deployment plumbing ---
TZ=Asia/Seoul
POSTGRES_DB=remine
POSTGRES_USER=remine_user
POSTGRES_PASSWORD=
# Overridden per-deploy by the GitHub Actions workflow with the commit SHA;
# left at "latest" here only for local/manual runs.
IMAGE_TAG=latest
# GitHub org/user that owns the GHCR packages, e.g. "arror1784".
GHCR_OWNER=
